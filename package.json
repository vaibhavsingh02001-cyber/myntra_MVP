{
  "name": "myntra-ai-agent",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "services/agent1-nudge",
    "services/agent2-fit",
    "shared"
  ],
  "scripts": {
    "dev:agent1": "npm run dev --workspace=services/agent1-nudge",
    "dev:agent2": "npm run dev --workspace=services/agent2-fit",
    "dev:all": "concurrently \"npm:dev:agent1\" \"npm:dev:agent2\"",
    "test": "jest --passWithNoTests --coverage",
    "build": "node scripts/build.js",
    "migrate": "node shared/db/migrate.js",
    "seed": "ts-node shared/db/seed.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "pg": "^8.12.0",
    "ioredis": "^5.4.1",
    "amqplib": "^0.10.4",
    "axios": "^1.7.2",
    "groq-sdk": "^1.6.0",
    "@google/generative-ai": "^0.14.0",
    "firebase-admin": "^12.2.0",
    "node-cron": "^3.0.3"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "concurrently": "^8.0.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.6",
    "@types/amqplib": "^0.10.5",
    "@types/node-cron": "^3.0.11"
  }
}
